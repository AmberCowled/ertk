{
	"name": "ertk",
	"version": "0.1.4",
	"description": "Easy RTK — Define endpoints once, generate RTK Query hooks and route handlers automatically",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./next": {
			"types": "./dist/next/index.d.ts",
			"import": "./dist/next/index.js"
		}
	},
	"bin": {
		"ertk": "dist/cli.js"
	},
	"files": [
		"dist",
		"!dist/**/*.map"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"prepublishOnly": "tsc"
	},
	"keywords": [
		"rtk",
		"redux",
		"rtk-query",
		"codegen",
		"next.js",
		"api",
		"endpoints"
	],
	"author": "Amber Cowled",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZackaryCowled/ertk.git"
	},
	"homepage": "https://github.com/ZackaryCowled/ertk#readme",
	"bugs": {
		"url": "https://github.com/ZackaryCowled/ertk/issues"
	},
	"pnpm": {
		"overrides": {
			"minimatch": ">=10.2.3",
			"picomatch": ">=4.0.4",
			"brace-expansion": ">=5.0.6",
			"postcss": ">=8.5.10"
		}
	},
	"dependencies": {
		"jiti": "^2.4.2",
		"ts-morph": "^27.0.2"
	},
	"peerDependencies": {
		"@reduxjs/toolkit": "^2.0.0",
		"next": ">=14.0.0",
		"react": ">=18.0.0",
		"react-redux": "^9.0.0",
		"typescript": "^5.0.0",
		"zod": "^3.0.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@reduxjs/toolkit": "^2.5.0",
		"@types/node": "^22.0.0",
		"next": "^16.2.9",
		"react": "^19.0.0",
		"react-redux": "^9.2.0",
		"typescript": "^5.0.0",
		"zod": "^4.0.0"
	}
}
